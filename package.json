{
  "name": "discover-50-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "preview": "vite preview",
    "lint": "cross-env NODE_ENV=production pnpm exec eslint \"src/**/*.{ts,tsx}\" --config ./eslint.config.mjs --max-warnings 0",
    "lint:fix": "cross-env NODE_ENV=production pnpm exec eslint \"src/**/*.{ts,tsx}\" --config ./eslint.config.mjs --fix --report-unused-disable-directives",
    "typecheck": "pnpm exec tsc --noEmit -p ./tsconfig.json",
    "format": "pnpm exec prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "pnpm exec prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:audit-ci": "audit-ci --config .audit-ci.json",
    "security:check": "pnpm run typecheck && pnpm run lint && pnpm run security:audit",
    "security:check-ci": "pnpm run typecheck && pnpm run lint && pnpm run security:audit-ci",
    "security:full": "pnpm run security:check && pnpm run format:check",
    "supabase:link": "supabase link",
    "supabase:dev": "supabase start",
    "supabase:deploy": "supabase db push",
    "prepare": "husky"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.54.0",
    "@tailwindcss/vite": "^4.1.11",

    "@tanstack/react-query": "^5.83.1",
    "@vercel/analytics": "^1.5.0",

    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "input-otp": "^1.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^7.8.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react-swc": "^3.10.1",
    "audit-ci": "^7.1.0",
    "cross-env": "^10.0.0",
    "dotenv-expand": "^12.0.2",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "supabase": "^2.34.3",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
