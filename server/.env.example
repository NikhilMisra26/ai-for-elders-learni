# Server Configuration
PORT=3001
NODE_ENV=development

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ADVANCED=price_id_for_advanced
STRIPE_PRICE_EXPERT=price_id_for_expert
STRIPE_API_VERSION=2023-10-16

# Supabase (for database access)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Development CORS Origins (optional - defaults to localhost variations)
DEV_CORS_ORIGIN_1=http://localhost:5173
DEV_CORS_ORIGIN_2=https://localhost:5173

# Rate Limiting Configuration (optional - defaults provided)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_GENERAL_MAX=100   # General requests per window
RATE_LIMIT_API_MAX=10        # API requests per window
RATE_LIMIT_WEBHOOK_MAX=1000  # Webhook requests per window

# Request Body Size Limits (optional - defaults provided)
WEBHOOK_BODY_LIMIT=1mb       # Stripe webhook payload size
API_BODY_LIMIT=10kb          # API request body size
URLENCODED_BODY_LIMIT=10kb   # URL-encoded body size

# Business Logic Configuration (optional - defaults provided)
GRACE_PERIOD_DAYS=7          # Payment failure grace period

# Analytics Configuration (optional - defaults provided)
ANALYTICS_CACHE_DURATION_MS=300000  # 5 minutes in milliseconds