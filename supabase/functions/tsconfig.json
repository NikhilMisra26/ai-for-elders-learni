{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "noEmit": true,
    "types": []
  },
  "include": ["./**/*.ts", "./deno.d.ts"],
  "exclude": ["node_modules"]
}
