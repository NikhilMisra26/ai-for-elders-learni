# Copy to .env.local and fill with your Supabase project credentials
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe Configuration (Frontend)
VITE_STRIPE_PUBLISHABLE_KEY=

# Stripe Price IDs (create these in Stripe Dashboard)
# Advanced Plan: $1.99/month
VITE_STRIPE_PRICE_ADVANCED_MONTHLY=
VITE_STRIPE_AMOUNT_ADVANCED_MONTHLY=199

# Expert Plan: $4.99/month
VITE_STRIPE_PRICE_EXPERT_MONTHLY=
VITE_STRIPE_AMOUNT_EXPERT_MONTHLY=499

# Backend API URL (defaults to http://localhost:3001)
VITE_API_URL=http://localhost:3001

# Security Configuration (optional - defaults provided)
VITE_MAX_LOGIN_ATTEMPTS=5             # Maximum failed login attempts before lockout
VITE_LOCKOUT_DURATION_MINUTES=15      # Account lockout duration in minutes
VITE_PASSWORD_MIN_LENGTH=8            # Minimum password length
VITE_PASSWORD_REQUIRE_SPECIAL_CHAR=true  # Require special characters in passwords
VITE_PASSWORD_REQUIRE_NUMBER=true     # Require numbers in passwords
VITE_SESSION_TIMEOUT_MINUTES=60       # Session timeout in minutes (senior-friendly)

# Analytics Configuration (optional - defaults provided)
VITE_ANALYTICS_CACHE_DURATION_MS=300000  # Analytics cache duration (5 minutes)
