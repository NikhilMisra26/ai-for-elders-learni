# Copy to .env.local and fill with your project credentials

# Required: Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Required: Application URL (for CORS configuration)
# Development: http://localhost:5173
# Production: https://yourdomain.com
VITE_APP_URL=
# Note: Provide full origin (scheme + host [+ optional port]) and DO NOT include a trailing slash.
# Example valid: https://example.com  |  http://localhost:5173
# Example invalid: https://example.com/

# Optional: Local API configuration (if running a separate backend)
# VITE_API_URL=http://localhost:3000

# Optional: Analytics configuration
# VITE_ANALYTICS_CACHE_DURATION_MS=300000

# Optional: Metrics thresholds for homepage display
# VITE_MIN_USERS=1000
# VITE_MIN_COMPLETION_RATE=85
# VITE_MIN_RATING=4.0
# VITE_MIN_COUNTRIES=5
